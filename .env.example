# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Port for Fisher Frontend. Must NOT be 8000 (SillyTavern lives there).
PORT=8787

# Bind address. 0.0.0.0 makes it reachable over Tailscale.
HOST=0.0.0.0

# Model used for generation.
MODEL=claude-opus-5

# Max tokens per reply.
MAX_TOKENS=8000

# Extended thinking: "adaptive" (on) or "off".
THINKING=adaptive

# Where the SQLite file lives (relative to project root).
DATA_DIR=./data

# World Info (лорбуки) — глобальные настройки, как в SillyTavern.
# Сколько последних сообщений сканируется по ключам.
WI_SCAN_DEPTH=2
# Сработавшая запись может активировать другие.
WI_RECURSIVE=true
# Учитывать регистр ключей.
WI_CASE_SENSITIVE=false
# Совпадение только по целым словам. Внимание: как и в SillyTavern, для
# кириллических ключей эта настройка ничего не меняет — границу слова там
# задаёт \W, а он считает кириллицу не-буквой.
WI_MATCH_WHOLE_WORDS=true
